<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>NEManager.App</RootNamespace>
    <AssemblyName>NE.Manager</AssemblyName>
    <NoWarn>CS1591;CA1416;CS0649;CS0169</NoWarn>
    <Version>3.1.0.0</Version>
    <Company>NewEra Studio</Company>
    <Product>NE 管理器</Product>
    <InformationalVersion>3.1.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NE.Core\NE.Core.csproj" />
    <ProjectReference Include="..\NE.Native\NE.Native.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.77" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Text" />
  </ItemGroup>

</Project>






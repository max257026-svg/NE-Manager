<UserControl x:Class="NEManager.App.Views.InjectorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDeepBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 + 警告 -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="DLL 注入器" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
            <Border Background="{StaticResource DangerBrush}" CornerRadius="3" Padding="8,3"
                    Margin="12,2,0,0" VerticalAlignment="Center">
                <TextBlock Text="高危操作：需要 SeDebug 特权 / 管理员权限"
                           FontSize="11.5" FontWeight="SemiBold" Foreground="White"/>
            </Border>
        </StackPanel>

        <!-- 输入区 -->
        <Border Grid.Row="1" Background="{StaticResource BgPanelBrush}" CornerRadius="6" Margin="0,0,0,12">
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 目标进程 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="目标进程 (PID):" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,10"/>
                <TextBox x:Name="PidBox" Grid.Row="0" Grid.Column="1" Text="0" Padding="10,5"
                         VerticalContentAlignment="Center" Margin="0,0,10,10"/>
                <Button x:Name="RefreshProcsBtn" Grid.Row="0" Grid.Column="2" Content="选择进程..."
                        Style="{StaticResource ToolButton}" Margin="0,0,0,10" Click="RefreshProcs_Click"/>

                <!-- DLL 路径 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="DLL 路径:" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,10"/>
                <TextBox x:Name="DllPathBox" Grid.Row="1" Grid.Column="1" Padding="10,5"
                         VerticalContentAlignment="Center" Margin="0,0,10,10"/>
                <Button x:Name="BrowseDllBtn" Grid.Row="1" Grid.Column="2" Content="浏览..."
                        Style="{StaticResource ToolButton}" Margin="0,0,0,10" Click="BrowseDll_Click"/>

                <!-- 注入按钮 -->
                <Button x:Name="InjectBtn" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                        Content="注 入" Style="{StaticResource AccentButton}" Height="36"
                        FontWeight="Bold" Margin="0,8,0,0" Click="Inject_Click"/>
            </Grid>
        </Border>

        <!-- 结果 + 进程列表 -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="ProcessGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="None"
                      Background="{StaticResource BgPanelBrush}" Foreground="{StaticResource TextBrush}"
                      BorderThickness="0" RowHeight="28" SelectionMode="Single"
                      MouseDoubleClick="ProcessGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="70"/>
                    <DataGridTextColumn Header="进程名" Binding="{Binding ProcessName}" Width="160"/>
                    <DataGridTextColumn Header="主窗口" Binding="{Binding MainWindowTitle}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="1" Background="{StaticResource BgDarkBrush}" CornerRadius="6,6,0,0" Margin="0,6,0,0">
                <TextBlock x:Name="ResultBox" Margin="14,10" Text="结果将显示在此处..."
                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" FontSize="11.5"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<Window x:Class="NEManager.App.Views.PreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件预览" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDeepBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,10" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="PreviewTitle" Style="{StaticResource SectionTitle}" Margin="0,0,20,0"/>
                <TextBlock x:Name="PreviewType" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 预览内容 -->
        <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="0">
            <Grid x:Name="PreviewContainer">
                <!-- 动态加载预览内容 -->
            </Grid>
        </Border>
    </Grid>
</Window>

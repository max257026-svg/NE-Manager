<Window x:Class="NEManager.App.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="230" Width="480" MinWidth="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgDeepBrush}"
        FontFamily="{StaticResource UIFont}"
        Foreground="{StaticResource TextBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" Style="{StaticResource SectionTitle}"/>
        <TextBlock Grid.Row="1" x:Name="MessageText" Style="{StaticResource SubTitle}" Margin="0,0,0,10"/>

        <TextBox Grid.Row="2" x:Name="InputBox" VerticalContentAlignment="Center" Height="34"
                 KeyDown="InputBox_KeyDown"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="确定" Style="{StaticResource AccentButton}" Click="Ok_Click" MinWidth="80"/>
            <Button Content="取消" Style="{StaticResource ToolButton}" Click="Cancel_Click" MinWidth="80"/>
        </StackPanel>
    </Grid>
</Window>

<UserControl x:Class="NEManager.App.Views.ServicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDeepBrush}"
             FontFamily="{StaticResource UIFont}">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════ 工具栏 ══════════ -->
        <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,10" Padding="10">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="刷新" Style="{StaticResource ToolButton}" Padding="10,5" Click="Refresh_Click"/>
                    <Button Content="启动" Style="{StaticResource AccentButton}" Padding="10,5" Click="Start_Click"/>
                    <Button Content="停止" Style="{StaticResource DangerButton}" Padding="10,5" Click="Stop_Click"/>
                    <Button Content="重启" Style="{StaticResource ToolButton}" Padding="10,5" Click="Restart_Click" Margin="4,0,0,0"/>
                    <Separator Width="12" Background="Transparent"/>
                    <TextBlock Text="启动类型：" VerticalAlignment="Center" Style="{StaticResource StatusText}" Margin="0,0,6,0"/>
                    <ComboBox x:Name="StartTypeBox" Width="110" VerticalContentAlignment="Center" SelectedIndex="1">
                        <ComboBoxItem Content="自动" Tag="Automatic"/>
                        <ComboBoxItem Content="手动" Tag="Manual"/>
                        <ComboBoxItem Content="禁用" Tag="Disabled"/>
                    </ComboBox>
                    <Button Content="应用" Style="{StaticResource ToolButton}" Padding="10,5" Click="ApplyStartType_Click" Margin="4,0,0,0"/>
                    <Separator Width="12" Background="Transparent"/>
                    <Button Content="导出清单" Style="{StaticResource ToolButton}" Padding="10,5" Click="Export_Click"/>
                    <Button Content="新建服务…" Style="{StaticResource DangerButton}" Padding="10,5" Click="CreateService_Click" Margin="4,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="筛选：" VerticalAlignment="Center" Style="{StaticResource StatusText}" Margin="0,0,6,0"/>
                    <TextBox x:Name="FilterBox" Width="180" VerticalContentAlignment="Center"
                             TextChanged="FilterBox_TextChanged"/>
                    <CheckBox x:Name="IncludeDriversBox" Content="含驱动" IsChecked="True" Margin="12,0,0,0"
                              Checked="IncludeDrivers_Changed" Unchecked="IncludeDrivers_Changed"/>
                    <TextBlock x:Name="CountText" Style="{StaticResource StatusText}" Margin="12,0,0,0"
                               Foreground="{StaticResource InfoBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════ 服务列表 ══════════ -->
        <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="8">
            <DataGrid x:Name="ServiceGrid">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="启动" Click="Start_Click"/>
                        <MenuItem Header="停止" Click="Stop_Click"/>
                        <MenuItem Header="重启" Click="Restart_Click"/>
                        <Separator/>
                        <MenuItem Header="设为自动启动" Click="SetAutomatic_Click"/>
                        <MenuItem Header="设为手动启动" Click="SetManual_Click"/>
                        <MenuItem Header="设为禁用" Click="SetDisabled_Click"/>
                        <Separator/>
                        <MenuItem Header="修改可执行路径…" Click="ChangePath_Click"/>
                        <MenuItem Header="复制二进制路径" Click="CopyPath_Click"/>
                        <MenuItem Header="删除服务…" Click="DeleteService_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="显示名称" Binding="{Binding DisplayName}" Width="220"/>
                    <DataGridTextColumn Header="服务名" Binding="{Binding Name}" Width="180"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="80"/>
                    <DataGridTextColumn Header="启动类型" Binding="{Binding StartTypeText}" Width="80"/>
                    <DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="80"/>
                    <DataGridTextColumn Header="登录账户" Binding="{Binding Account}" Width="140"/>
                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="60"/>
                    <DataGridTextColumn Header="可执行路径" Binding="{Binding BinaryPath}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>

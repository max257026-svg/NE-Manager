<UserControl x:Class="NEManager.App.Views.ToolboxPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDeepBrush}">
    <Grid Margin="14">
        <TabControl>
            <!-- 进制转换 -->
            <TabItem Header="进制转换">
                <Border Style="{StaticResource CardPanel}" Margin="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="输入数值:" Style="{StaticResource SectionTitle}"/>
                        <TextBox x:Name="ConverterInput" Width="400" HorizontalAlignment="Left" Margin="0,0,0,15"
                                 TextChanged="ConverterInput_Changed"/>
                        <TextBlock Text="二进制:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <TextBox x:Name="BinaryOutput" Width="400" HorizontalAlignment="Left" IsReadOnly="True" Margin="0,0,0,10"/>
                        <TextBlock Text="八进制:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <TextBox x:Name="OctalOutput" Width="400" HorizontalAlignment="Left" IsReadOnly="True" Margin="0,0,0,10"/>
                        <TextBlock Text="十进制:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <TextBox x:Name="DecimalOutput" Width="400" HorizontalAlignment="Left" IsReadOnly="True" Margin="0,0,0,10"/>
                        <TextBlock Text="十六进制:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <TextBox x:Name="HexOutput" Width="400" HorizontalAlignment="Left" IsReadOnly="True"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- 哈希计算 -->
            <TabItem Header="哈希计算">
                <Border Style="{StaticResource CardPanel}" Margin="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="文件路径:" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBox x:Name="HashFilePath" Width="500" VerticalContentAlignment="Center"/>
                            <Button Content="浏览" Style="{StaticResource ToolButton}" Click="BrowseHashFile_Click" Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="算法:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="HashAlgorithmSelector" Width="200" HorizontalAlignment="Left" Margin="0,0,0,15">
                            <ComboBoxItem Content="MD5"/>
                            <ComboBoxItem Content="SHA1"/>
                            <ComboBoxItem Content="SHA256" IsSelected="True"/>
                            <ComboBoxItem Content="SHA512"/>
                        </ComboBox>
                        <Button Content="计算哈希" Style="{StaticResource AccentButton}" Click="ComputeHash_Click" HorizontalAlignment="Left"/>
                        <TextBlock Text="哈希值:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,15,0,5"/>
                        <TextBox x:Name="HashResult" Width="600" HorizontalAlignment="Left" IsReadOnly="True" 
                                 Height="80" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- 编码转换 -->
            <TabItem Header="编码转换">
                <Border Style="{StaticResource CardPanel}" Margin="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="输入文本:" Style="{StaticResource SectionTitle}"/>
                        <TextBox x:Name="EncodingInput" Width="600" HorizontalAlignment="Left" Height="100"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="源编码:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="FromEncoding" Width="150"/>
                            <TextBlock Text="目标编码:" VerticalAlignment="Center" Margin="20,0,6,0"/>
                            <ComboBox x:Name="ToEncoding" Width="150"/>
                        </StackPanel>
                        <Button Content="转换" Style="{StaticResource AccentButton}" Click="ConvertEncoding_Click" HorizontalAlignment="Left"/>
                        <TextBlock Text="输出:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,15,0,5"/>
                        <TextBox x:Name="EncodingOutput" Width="600" HorizontalAlignment="Left" Height="100"
                                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- 时间戳转换 -->
            <TabItem Header="时间戳转换">
                <Border Style="{StaticResource CardPanel}" Margin="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Unix 时间戳:" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBox x:Name="TimestampInput" Width="200" VerticalContentAlignment="Center"/>
                            <Button Content="转换为日期" Style="{StaticResource ToolButton}" Click="TimestampToDate_Click" Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBox x:Name="TimestampToDateResult" Width="400" HorizontalAlignment="Left" IsReadOnly="True" Margin="0,0,0,20"/>
                        
                        <TextBlock Text="日期时间:" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBox x:Name="DateTimeInput" Width="250" VerticalContentAlignment="Center"/>
                            <Button Content="转换为时间戳" Style="{StaticResource ToolButton}" Click="DateToTimestamp_Click" Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBox x:Name="DateToTimestampResult" Width="400" HorizontalAlignment="Left" IsReadOnly="True"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- Base64 -->
            <TabItem Header="Base64">
                <Border Style="{StaticResource CardPanel}" Margin="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="输入文本:" Style="{StaticResource SectionTitle}"/>
                        <TextBox x:Name="Base64Input" Width="600" HorizontalAlignment="Left" Height="100"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Button Content="编码" Style="{StaticResource AccentButton}" Click="Base64Encode_Click"/>
                            <Button Content="解码" Style="{StaticResource ToolButton}" Click="Base64Decode_Click" Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="输出:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <TextBox x:Name="Base64Output" Width="600" HorizontalAlignment="Left" Height="100"
                                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- URL 编解码 -->
            <TabItem Header="URL 编解码">
                <Border Style="{StaticResource CardPanel}" Margin="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="输入文本:" Style="{StaticResource SectionTitle}"/>
                        <TextBox x:Name="UrlInput" Width="600" HorizontalAlignment="Left" Height="100"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Button Content="编码" Style="{StaticResource AccentButton}" Click="UrlEncode_Click"/>
                            <Button Content="解码" Style="{StaticResource ToolButton}" Click="UrlDecode_Click" Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="输出:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <TextBox x:Name="UrlOutput" Width="600" HorizontalAlignment="Left" Height="100"
                                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- 正则测试 -->
            <TabItem Header="正则测试">
                <Border Style="{StaticResource CardPanel}" Margin="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="正则表达式:" Style="{StaticResource SectionTitle}"/>
                        <TextBox x:Name="RegexPattern" Width="600" HorizontalAlignment="Left" Margin="0,0,0,15"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock Text="测试文本:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <TextBox x:Name="RegexInput" Width="600" HorizontalAlignment="Left" Height="150"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15"/>
                        <Button Content="测试" Style="{StaticResource AccentButton}" Click="RegexTest_Click" HorizontalAlignment="Left"/>
                        <TextBlock Text="匹配结果:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,15,0,5"/>
                        <TextBox x:Name="RegexResult" Width="600" HorizontalAlignment="Left" Height="150"
                                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- 颜色拾取 -->
            <TabItem Header="颜色拾取">
                <Border Style="{StaticResource CardPanel}" Margin="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="HEX 颜色值:" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBox x:Name="ColorHexInput" Width="150" VerticalContentAlignment="Center" Text="#FF5733"/>
                            <Button Content="应用" Style="{StaticResource ToolButton}" Click="ColorHex_Changed" Margin="6,0,0,0"/>
                        </StackPanel>
                        <Border x:Name="ColorPreview" Width="200" Height="100" CornerRadius="6"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Background="#FF5733" Margin="0,0,0,15"/>
                        <TextBlock Text="RGB 值:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <TextBlock x:Name="ColorRgbText" FontFamily="{StaticResource MonoFont}" FontSize="13"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

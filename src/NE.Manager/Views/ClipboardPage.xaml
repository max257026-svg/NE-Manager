<UserControl x:Class="NEManager.App.Views.ClipboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BgPanelBrush}"
                CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="剪贴板历史" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="（已停止）" Margin="8,0,0,0" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ToggleBtn" Content="开始监控" Style="{StaticResource AccentButton}" Click="Toggle_Click"/>
                    <Button Content="清空" Style="{StaticResource ToolButton}" Click="Clear_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 历史列表 -->
            <ListBox x:Name="HistoryList" Grid.Column="0"
                     Background="{StaticResource BgPanelBrush}" Foreground="{StaticResource TextBrush}"
                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                     SelectionMode="Single" SelectionChanged="HistoryList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,6" Margin="2">
                            <StackPanel>
                                <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MaxHeight="36" Foreground="{StaticResource TextBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Timestamp}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding Length, StringFormat='({0} chars)'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 分隔 -->
            <Border Grid.Column="1" Background="{StaticResource BorderBrush}"/>

            <!-- 预览 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="PreviewBox" AcceptsReturn="True" TextWrapping="Wrap"
                         IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12"
                         Background="{StaticResource BgPanelBrush}" Foreground="{StaticResource TextBrush}"
                         BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                         VerticalScrollBarVisibility="Auto"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="复制回剪贴板" Style="{StaticResource AccentButton}" Click="CopyBack_Click"/>
                    <Button Content="编辑并重写" Style="{StaticResource ToolButton}" Click="EditRewrite_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

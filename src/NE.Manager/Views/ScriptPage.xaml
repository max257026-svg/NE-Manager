<UserControl x:Class="NEManager.App.Views.ScriptPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDeepBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,10" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="脚本类型:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <ComboBox x:Name="ScriptTypeSelector" Width="120">
                    <ComboBoxItem Content="Python" IsSelected="True"/>
                    <ComboBoxItem Content="PowerShell"/>
                    <ComboBoxItem Content="Batch"/>
                    <ComboBoxItem Content="Lua"/>
                </ComboBox>
                <Button Content="运行" Style="{StaticResource AccentButton}" Click="Run_Click" Margin="10,0,0,0"/>
                <Button Content="打开脚本文件" Style="{StaticResource ToolButton}" Click="OpenFile_Click" Margin="10,0,0,0"/>
                <Button Content="保存脚本" Style="{StaticResource ToolButton}" Click="SaveFile_Click" Margin="10,0,0,0"/>
                <Button Content="清空" Style="{StaticResource ToolButton}" Click="Clear_Click" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 编辑器和输出 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 脚本编辑器 -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}" Padding="0">
                <TextBox x:Name="ScriptEditor" FontFamily="{StaticResource MonoFont}" FontSize="13"
                         Foreground="{StaticResource TextBrush}" Background="{StaticResource BgPanelBrush}"
                         BorderThickness="0" AcceptsReturn="True" AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" Padding="10"/>
            </Border>

            <!-- 输出窗口 -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}" Padding="0">
                <TextBox x:Name="OutputWindow" FontFamily="{StaticResource MonoFont}" FontSize="13"
                         Foreground="{StaticResource TextBrush}" Background="{StaticResource BgDarkBrush}"
                         BorderThickness="0" IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" Padding="10"/>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Style="{StaticResource CardPanel}" Margin="0,10,0,0" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusText" Style="{StaticResource StatusText}" Text="就绪"/>
                <TextBlock x:Name="ExitCodeText" Style="{StaticResource StatusText}" Margin="20,0,0,0"
                           Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

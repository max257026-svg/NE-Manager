<UserControl x:Class="NEManager.App.Views.SystemInfoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BgPanelBrush}"
                CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="系统信息总览" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="刷新" Style="{StaticResource ToolButton}" Click="Refresh_Click"/>
                    <Button Content="导出 Markdown" Style="{StaticResource ToolButton}" Click="Export_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Background="{StaticResource BgBrush}" BorderThickness="0">
            <TabItem Header="操作系统">
                <DataGrid x:Name="OsGrid" Margin="8" AutoGenerateColumns="False"
                          Background="{StaticResource BgPanelBrush}" Foreground="{StaticResource TextBrush}"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="项目" Binding="{Binding Key}" Width="140"/>
                        <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="硬件">
                <DataGrid x:Name="HwGrid" Margin="8" AutoGenerateColumns="False"
                          Background="{StaticResource BgPanelBrush}" Foreground="{StaticResource TextBrush}"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="项目" Binding="{Binding Key}" Width="140"/>
                        <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="已装软件">
                <DataGrid x:Name="AppsGrid" Margin="8" AutoGenerateColumns="False"
                          Background="{StaticResource BgPanelBrush}" Foreground="{StaticResource TextBrush}"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="名称" Binding="{Binding name}" Width="*"/>
                        <DataGridTextColumn Header="版本" Binding="{Binding version}" Width="100"/>
                        <DataGridTextColumn Header="发布者" Binding="{Binding publisher}" Width="180"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="驱动">
                <DataGrid x:Name="DrvGrid" Margin="8" AutoGenerateColumns="False"
                          Background="{StaticResource BgPanelBrush}" Foreground="{StaticResource TextBrush}"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="名称" Binding="{Binding name}" Width="*"/>
                        <DataGridTextColumn Header="版本" Binding="{Binding version}" Width="140"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding status}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="网络">
                <DataGrid x:Name="NetGrid" Margin="8" AutoGenerateColumns="False"
                          Background="{StaticResource BgPanelBrush}" Foreground="{StaticResource TextBrush}"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="适配器" Binding="{Binding adapter}" Width="*"/>
                        <DataGridTextColumn Header="IP" Binding="{Binding ip}" Width="140"/>
                        <DataGridTextColumn Header="MAC" Binding="{Binding mac}" Width="140"/>
                        <DataGridTextColumn Header="速度" Binding="{Binding speed}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

<UserControl x:Class="NEManager.App.Views.RegistryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDeepBrush}"
             FontFamily="{StaticResource UIFont}">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════ 地址栏 ══════════ -->
        <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="路径：" VerticalAlignment="Center" Margin="0,0,8,0"
                           Style="{StaticResource StatusText}"/>
                <TextBox Grid.Column="1" x:Name="PathBox" VerticalContentAlignment="Center"
                         Text="HKEY_LOCAL_MACHINE\SOFTWARE" KeyDown="PathBox_KeyDown"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Content="跳转" Style="{StaticResource ToolButton}" Click="Go_Click"/>
                    <Button Content="刷新" Style="{StaticResource ToolButton}" Click="Refresh_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════ 主体 ══════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="260"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- 键树 -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource SectionTitle}" Margin="4,0,0,8" Text="注册表项"/>

                    <TreeView Grid.Row="1" x:Name="KeyTree"
                              SelectedItemChanged="KeyTree_SelectedChanged"
                              BorderThickness="0" Background="Transparent"
                              TreeViewItem.Expanded="KeyTree_Expanded">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}"/>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="12" Background="Transparent"/>

            <!-- 值列表 -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,0,4,8">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="键值" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="新建值" Style="{StaticResource ToolButton}" Click="NewValue_Click"/>
                            <Button Content="编辑" Style="{StaticResource ToolButton}" Click="EditValue_Click"/>
                            <Button Content="删除" Style="{StaticResource DangerButton}" Click="DeleteValue_Click"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1" x:Name="ValueGrid" MouseDoubleClick="ValueGrid_DoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="编辑值数据" Click="EditValue_Click"/>
                                <MenuItem Header="重命名值" Click="RenameValue_Click"/>
                                <MenuItem Header="复制值名称" Click="CopyValueName_Click"/>
                                <MenuItem Header="复制值数据" Click="CopyValueData_Click"/>
                                <Separator/>
                                <MenuItem Header="删除值" Click="DeleteValue_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding DisplayName}" Width="220"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding KindText}" Width="120"/>
                            <DataGridTextColumn Header="数据" Binding="{Binding DisplayText}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════ 工具条 ══════════ -->
        <Border Grid.Row="2" Style="{StaticResource CardPanel}" Margin="0,10,0,0" Padding="10">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="新建项" Style="{StaticResource ToolButton}" Click="NewKey_Click"/>
                    <Button Content="重命名项" Style="{StaticResource ToolButton}" Click="RenameKey_Click"/>
                    <Button Content="删除项" Style="{StaticResource DangerButton}" Click="DeleteKey_Click"/>
                    <Separator Width="10" Background="Transparent"/>
                    <Button Content="导出分支" Style="{StaticResource ToolButton}" Click="ExportBranch_Click"/>
                    <Button Content="搜索注册表" Style="{StaticResource ToolButton}" Click="Search_Click"/>
                    <Separator Width="10" Background="Transparent"/>
                    <Button Content="权限 (ACL)" Style="{StaticResource ToolButton}" Click="ViewAcl_Click"/>
                    <Button Content="加载离线 Hive" Style="{StaticResource ToolButton}" Click="LoadHive_Click"/>
                </StackPanel>

                <TextBlock x:Name="StatusHint" Style="{StaticResource StatusText}"
                           HorizontalAlignment="Right" Text=""/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

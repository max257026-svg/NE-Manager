<UserControl x:Class="NEManager.App.Views.FilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDeepBrush}"
             FontFamily="{StaticResource UIFont}">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════ 工具栏 ══════════ -->
        <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,6" Padding="8,6">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <!-- 导航按钮组 -->
                    <Button Content="&#xE72B;" Style="{StaticResource IconButton}" ToolTip="后退 (Alt+Left)" Click="Back_Click"/>
                    <Button Content="&#xE72A;" Style="{StaticResource IconButton}" ToolTip="前进 (Alt+Right)" Click="Forward_Click"/>
                    <Button Content="&#xE76B;" Style="{StaticResource IconButton}" ToolTip="上一级 (Backspace)" Click="Up_Click"/>
                    <Separator Width="6" Background="Transparent"/>
                    <Button Style="{StaticResource ToolButton}" Padding="10,5" Click="GoDrives_Click" ToolTip="驱动器列表 (Ctrl+D)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C3;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="驱动器" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="刷新" Style="{StaticResource ToolButton}" Padding="10,5" Click="Refresh_Click" ToolTip="刷新 (F5)"/>
                    <Separator Width="6" Background="Transparent"/>
                    <Button Content="复制 →" Style="{StaticResource ToolButton}" Padding="10,5" Click="CopyToRight_Click" ToolTip="F5复制选中项到对面面板"/>
                    <Button Content="移动 →" Style="{StaticResource ToolButton}" Padding="10,5" Click="MoveToRight_Click"/>
                    <Separator Width="6" Background="Transparent"/>
                    <Button Content="新建文件夹" Style="{StaticResource ToolButton}" Padding="10,5" Click="NewFolder_Click"/>
                    <Button Content="新建文件" Style="{StaticResource ToolButton}" Padding="10,5" Click="NewFile_Click"/>
                    <Button Content="重命名" Style="{StaticResource ToolButton}" Padding="10,5" Click="Rename_Click" ToolTip="F2"/>
                    <Button Content="属性" Style="{StaticResource ToolButton}" Padding="10,5" Click="Properties_Click" ToolTip="Alt+Enter"/>
                    <Button Content="删除" Style="{StaticResource DangerButton}" Padding="10,5" Click="Delete_Click" ToolTip="Delete"/>
                    <Button Content="解除占用" Style="{StaticResource DangerButton}" Padding="10,5" Click="KillLockers_Click" ToolTip="强制结束占用进程并删除文件"/>
                    <Separator Width="6" Background="Transparent"/>
                    <Button Content="🔬 PE分析" Style="{StaticResource ToolButton}" Padding="10,5" Click="AnalyzePe_Click" ToolTip="分析 EXE/DLL 的 PE 头、节表、签名、哈希"/>
                    <Button Content="🔩 反编译" Style="{StaticResource ToolButton}" Padding="10,5" Click="Decompile_Click" ToolTip="反编译 .NET DLL/EXE 成 C# 源码"/>
                    <Button Content="📋 Hex" Style="{StaticResource ToolButton}" Padding="10,5" Click="ViewHex_Click" ToolTip="十六进制查看文件原始字节"/>
                    <Button Content="📝 签名" Style="{StaticResource ToolButton}" Padding="10,5" Click="SignFile_Click" ToolTip="验证 Authenticode 数字签名"/>
                    <Button Content="🔒 PID" Style="{StaticResource ToolButton}" Padding="10,5" Click="ViewPid_Click" ToolTip="查看占用该文件的进程"/>
                    <Separator Width="6" Background="Transparent"/>
                    <Button Content="✏️ Hex编辑" Style="{StaticResource ToolButton}" Padding="10,5" Click="EditHex_Click" ToolTip="打开交互式十六进制编辑器，支持 patch 写入原文件"/>
                    <Button Content="💉 注入DLL" Style="{StaticResource DangerButton}" Padding="10,5" Click="InjectDll_Click" ToolTip="CreateRemoteThread 注入到目标进程（需要管理员）"/>
                    <Button Content="🔧 属性" Style="{StaticResource ToolButton}" Padding="10,5" Click="SetAttr_Click" ToolTip="修改 Hidden/ReadOnly/System 属性"/>
                    <Button Content="⏱ 时间戳" Style="{StaticResource ToolButton}" Padding="10,5" Click="SetTimestamp_Click" ToolTip="篡改文件创建/访问/修改时间"/>
                    <Button Content="📦 版本信息" Style="{StaticResource ToolButton}" Padding="10,5" Click="ReadVer_Click" ToolTip="读取 PE 版本资源（ProductName/CompanyName 等）"/>
                </StackPanel>

                <!-- 右侧：显示选项 + 搜索 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox x:Name="ShowHiddenBox" Content="隐藏" IsChecked="True"
                              Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed" Margin="0,0,6,0"/>
                    <CheckBox x:Name="ShowSystemBox" Content="系统" IsChecked="True"
                              Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed" Margin="0,0,6,0"/>
                    <CheckBox x:Name="DetectAdsBox" Content="ADS" IsChecked="False"
                              Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed" Margin="0,0,10,0"/>
                    <TextBox x:Name="FilterBox" Style="{StaticResource SearchBox}" Width="160"
                             TextChanged="FilterBox_TextChanged" Tag="Filter"
                             ToolTip="过滤文件名 (Ctrl+F)"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════ 双面板 ══════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ 快速访问侧边栏 ============ -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}" Padding="6" Margin="0,0,4,6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="QuickAccessPanel">
                        <TextBlock Text="快速访问" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="6,4,0,4"/>
                        <Button Style="{StaticResource NavButton}" Margin="2,1" Padding="10,6" Click="QuickAccess_Click" Tag="Desktop">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" Width="18" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="桌面" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Margin="2,1" Padding="10,6" Click="QuickAccess_Click" Tag="Downloads">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" Width="18"/>
                                <TextBlock Text="下载" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Margin="2,1" Padding="10,6" Click="QuickAccess_Click" Tag="Documents">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" Width="18"/>
                                <TextBlock Text="文档" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Margin="2,1" Padding="10,6" Click="QuickAccess_Click" Tag="Pictures">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A9;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" Width="18"/>
                                <TextBlock Text="图片" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Margin="2,1" Padding="10,6" Click="QuickAccess_Click" Tag="Music">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" Width="18"/>
                                <TextBlock Text="音乐" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Margin="2,1" Padding="10,6" Click="QuickAccess_Click" Tag="Videos">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B2;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" Width="18"/>
                                <TextBlock Text="视频" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Separator Margin="6,10,6,6" Background="{StaticResource BorderBrush}"/>
                        <TextBlock Text="位置" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="6,4,0,4"/>
                        <Button Style="{StaticResource NavButton}" Margin="2,1" Padding="10,6" Click="QuickAccess_Click" Tag="ThisPC">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE882;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" Width="18"/>
                                <TextBlock Text="此电脑" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Margin="2,1" Padding="10,6" Click="QuickAccess_Click" Tag="Network">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" Width="18"/>
                                <TextBlock Text="网络" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 原有双面板 -->
            <Grid Grid.Column="1" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                </Grid.ColumnDefinitions>

            <!-- 左面板 -->
            <Border Grid.Column="0" x:Name="LeftPaneBorder" Style="{StaticResource CardPanel}" Padding="6"
                    Margin="0,0,0,6"
                    MouseLeftButtonDown="LeftPane_Click">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 面板标题 + 面包屑 -->
                    <Border Grid.Row="0" x:Name="LeftPaneHeader" Background="#FF2D2D2E"
                            CornerRadius="8" Padding="8,5" Margin="0,0,0,4"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="◀ 活动面板" x:Name="LeftPaneTitle"
                                       Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" x:Name="LeftBreadcrumb" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" MouseLeftButtonDown="LeftBreadcrumb_Click" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- 地址栏 -->
                    <Grid Grid.Row="1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="&#xE76B;" Style="{StaticResource IconButton}" ToolTip="上一级" Click="LeftUp_Click"/>
                        <Button Grid.Column="0" Content="&#xE72B;" Style="{StaticResource IconButton}" ToolTip="后退" Click="LeftBack_Click" Margin="32,0,0,0"/>
                        <Button Grid.Column="0" Content="&#xE72A;" Style="{StaticResource IconButton}" ToolTip="前进" Click="LeftForward_Click" Margin="64,0,0,0"/>
                        <TextBox Grid.Column="1" x:Name="LeftPathBox" Margin="6,0" VerticalContentAlignment="Center"
                                 KeyDown="LeftPath_KeyDown"/>
                        <Button Grid.Column="2" Content="&#xE8C3;" Style="{StaticResource IconButton}" ToolTip="驱动器" Click="LeftDrives_Click"/>
                    </Grid>

                    <DataGrid Grid.Row="2" x:Name="LeftGrid" ItemsSource="{Binding LeftItems}"
                              SelectionChanged="LeftGrid_SelectionChanged"
                              MouseDoubleClick="LeftGrid_DoubleClick"
                              PreviewKeyDown="Grid_PreviewKeyDown"
                              AllowDrop="True" DragOver="Grid_DragOver" Drop="Grid_Drop">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="打开" InputGestureText="Enter" Click="OpenItem_Click"/>
                                <MenuItem Header="打开并编辑" Click="OpenEdit_Click"/>
                                <MenuItem Header="在资源管理器中显示" Click="OpenLocation_Click"/>
                                <Separator/>
                                <MenuItem Header="查看属性与权限" InputGestureText="Alt+Enter" Click="Properties_Click"/>
                                <MenuItem Header="备用数据流 (ADS)" Click="ViewStreams_Click"/>
                                <MenuItem Header="安全描述符 (ACL)" Click="ViewAcl_Click"/>
                                <Separator/>
                                <MenuItem Header="计算哈希" Click="Hash_Click"/>
                                <MenuItem Header="查找占用进程" Click="FindLocker_Click"/>
                                <MenuItem Header="复制完整路径" Click="CopyPath_Click"/>
                                <Separator/>
                                <MenuItem Header="接管所有权" Click="TakeOwn_Click"/>
                                <MenuItem Header="注册重启后替换" Click="ScheduleReplace_Click"/>
                                <Separator/>
                                <MenuItem Header="重命名" InputGestureText="F2" Click="Rename_Click"/>
                                <MenuItem Header="删除" InputGestureText="Del" Click="Delete_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"
                                                ElementStyle="{StaticResource FileNameCellStyle}"/>
                            <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="90"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="120"/>
                            <DataGridTextColumn Header="修改时间" Binding="{Binding LastWriteTime, StringFormat='yyyy-MM-dd HH:mm'}" Width="125"/>
                            <DataGridTextColumn Header="属性" Binding="{Binding AttributeText}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="3" Margin="4,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LeftStatus" Style="{StaticResource StatusText}" Text="—"/>
                        <TextBlock Grid.Column="1" x:Name="LeftDriveInfo" Style="{StaticResource StatusText}" Text=""/>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" Background="{StaticResource BorderBrush}"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- 右面板 -->
            <Border Grid.Column="2" x:Name="RightPaneBorder" Style="{StaticResource CardPanel}" Padding="6"
                    Margin="0,0,0,6"
                    MouseLeftButtonDown="RightPane_Click">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" x:Name="RightPaneHeader" Background="#FF2D2D2E"
                            CornerRadius="8" Padding="8,5" Margin="0,0,0,4"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="▶ 副面板" x:Name="RightPaneTitle"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" x:Name="RightBreadcrumb" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" MouseLeftButtonDown="RightBreadcrumb_Click" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="&#xE76B;" Style="{StaticResource IconButton}" Click="RightUp_Click"/>
                        <Button Grid.Column="0" Content="&#xE72B;" Style="{StaticResource IconButton}" ToolTip="后退" Click="RightBack_Click" Margin="32,0,0,0"/>
                        <Button Grid.Column="0" Content="&#xE72A;" Style="{StaticResource IconButton}" ToolTip="前进" Click="RightForward_Click" Margin="64,0,0,0"/>
                        <TextBox Grid.Column="1" x:Name="RightPathBox" Margin="6,0" VerticalContentAlignment="Center"
                                 KeyDown="RightPath_KeyDown"/>
                        <Button Grid.Column="2" Content="&#xE8C3;" Style="{StaticResource IconButton}" Click="RightDrives_Click"/>
                    </Grid>

                    <DataGrid Grid.Row="2" x:Name="RightGrid" ItemsSource="{Binding RightItems}"
                              SelectionChanged="RightGrid_SelectionChanged"
                              MouseDoubleClick="RightGrid_DoubleClick"
                              PreviewKeyDown="Grid_PreviewKeyDown"
                              AllowDrop="True" DragOver="Grid_DragOver" Drop="Grid_Drop">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="打开" Click="OpenItemRight_Click"/>
                                <MenuItem Header="在资源管理器中显示" Click="OpenLocationRight_Click"/>
                                <Separator/>
                                <MenuItem Header="查看属性与权限" Click="PropertiesRight_Click"/>
                                <MenuItem Header="备用数据流 (ADS)" Click="ViewStreamsRight_Click"/>
                                <MenuItem Header="安全描述符 (ACL)" Click="ViewAclRight_Click"/>
                                <Separator/>
                                <MenuItem Header="计算哈希" Click="HashRight_Click"/>
                                <MenuItem Header="查找占用进程" Click="FindLockerRight_Click"/>
                                <MenuItem Header="复制完整路径" Click="CopyPathRight_Click"/>
                                <Separator/>
                                <MenuItem Header="接管所有权" Click="TakeOwnRight_Click"/>
                                <Separator/>
                                <MenuItem Header="重命名" Click="RenameRight_Click"/>
                                <MenuItem Header="删除" Click="DeleteRight_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"
                                                ElementStyle="{StaticResource FileNameCellStyle}"/>
                            <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="90"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="120"/>
                            <DataGridTextColumn Header="修改时间" Binding="{Binding LastWriteTime, StringFormat='yyyy-MM-dd HH:mm'}" Width="125"/>
                            <DataGridTextColumn Header="属性" Binding="{Binding AttributeText}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="3" Margin="4,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RightStatus" Style="{StaticResource StatusText}" Text="—"/>
                        <TextBlock Grid.Column="1" x:Name="RightDriveInfo" Style="{StaticResource StatusText}" Text=""/>
                    </Grid>
                </Grid>
            </Border>
            </Grid>
        </Grid>
    </Grid>

    <!-- 文件名列的着色样式（资源） -->
    <UserControl.Resources>
        <Style x:Key="FileNameCellStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
    </UserControl.Resources>
</UserControl>


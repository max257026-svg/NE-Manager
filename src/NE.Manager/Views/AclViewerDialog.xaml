<Window x:Class="NEManager.App.Views.AclViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="640" Width="980" MinHeight="400" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDeepBrush}"
        FontFamily="{StaticResource UIFont}"
        Foreground="{StaticResource TextBrush}">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="安全描述符 (ACL)"/>
                <TextBlock x:Name="PathText" Style="{StaticResource MonoText}"
                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardPanel}" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="所有者：" Style="{StaticResource StatusText}"
                           FontWeight="SemiBold" Margin="0,0,6,0"/>
                <TextBlock Grid.Column="1" x:Name="OwnerText" Style="{StaticResource StatusText}"
                           TextWrapping="Wrap" Margin="0,0,20,0"/>

                <TextBlock Grid.Column="2" Text="组：" Style="{StaticResource StatusText}"
                           FontWeight="SemiBold" Margin="0,0,6,0"/>
                <TextBlock Grid.Column="3" x:Name="GroupText" Style="{StaticResource StatusText}"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="DACL（访问控制）">
                <Border Style="{StaticResource CardPanel}" Padding="8" Margin="0,8,0,0">
                    <DataGrid x:Name="DaclGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="类型" Binding="{Binding KindText}" Width="60"/>
                            <DataGridTextColumn Header="主体" Binding="{Binding Trustee}" Width="240"/>
                            <DataGridTextColumn Header="权限" Binding="{Binding Rights}" Width="*"/>
                            <DataGridTextColumn Header="继承" Binding="{Binding InheritanceText}" Width="150"/>
                            <DataGridTextColumn Header="掩码" Binding="{Binding AccessMaskText}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <TabItem Header="SACL（审计规则）">
                <Border Style="{StaticResource CardPanel}" Padding="8" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" x:Name="SaclNotice" Style="{StaticResource SubTitle}"
                                   Margin="0,0,0,8"/>
                        <DataGrid Grid.Row="1" x:Name="SaclGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="主体" Binding="{Binding Trustee}" Width="240"/>
                                <DataGridTextColumn Header="权限" Binding="{Binding Rights}" Width="*"/>
                                <DataGridTextColumn Header="成功" Binding="{Binding SuccessAudit}" Width="70"/>
                                <DataGridTextColumn Header="失败" Binding="{Binding FailureAudit}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="SDDL 原始">
                <Border Style="{StaticResource CardPanel}" Padding="8" Margin="0,8,0,0">
                    <TextBox x:Name="SddlBox" IsReadOnly="True"
                             Background="{StaticResource BgDarkBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderThickness="0"
                             FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8"/>
                </Border>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="复制 SDDL" Style="{StaticResource ToolButton}" Click="CopySddl_Click"/>
            <Button Content="关闭" Style="{StaticResource AccentButton}" Click="Close_Click" MinWidth="90"/>
        </StackPanel>
    </Grid>
</Window>

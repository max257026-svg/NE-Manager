<UserControl x:Class="NEManager.App.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDeepBrush}"
             FontFamily="{StaticResource UIFont}">
    <ScrollViewer Margin="14">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <Border Style="{StaticResource CardPanel}" Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="{StaticResource AccentBrush}" CornerRadius="5"
                                Width="32" Height="32" Margin="0,0,12,0">
                            <TextBlock Text="NE" Foreground="White" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="NE 管理器" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="由 新启年工作室 (NewEra Studio) 开发" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="定位" FontWeight="SemiBold" FontSize="14" Margin="0,6,0,6"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                               Text="Windows 平台对标 Android MT 管理器的增强型文件与系统资源管理器。在管理员 / TrustedInstaller 权限下，
提供系统文件深度修改、注册表完整编辑、进程 / 服务管理、PE 二进制解析、卷与虚拟磁盘底层操作、
WMI 控制台以及统一的高危操作风险框架。"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="能力分层" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                    <TextBlock Text="· 应用层（常做）：双面板文件管理、ADS 流、ACL 编辑、注册表、PE 解析、进程 / 服务、WMI"
                               TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,2"/>
                    <TextBlock Text="· 系统高权限层（需管理员 / TrustedInstaller）：接管系统文件、Se 特权、卷影、BCD 修改"
                               TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,2"/>
                    <TextBlock Text="· 内核辅助层（可选，V1 不内置）：文件过滤驱动、内核对象查看 —— 建议独立配套工具"
                               TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,2"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Padding="16">
                <StackPanel>
                    <TextBlock Text="风险提示" FontWeight="SemiBold" FontSize="14"
                               Foreground="{StaticResource DangerBrush}" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                        替换系统文件、修改 BCD、写入原始磁盘、批量接管 TrustedInstaller 均为高危操作，失误可能导致系统无法启动。
                        所有高危操作均经过显式警告、自动备份、操作日志与回滚入口保护。建议普通用户保持在「普通模式」。
                    </TextBlock>
                </StackPanel>
            </Border>

            <TextBlock Text="版本 1.0  ·  .NET 8 / WPF  ·  零第三方 NuGet 依赖（仅系统 API 与 P/Invoke）"
                       Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>

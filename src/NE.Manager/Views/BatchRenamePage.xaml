<UserControl x:Class="NEManager.App.Views.BatchRenamePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDeepBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,10" Padding="10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="添加文件" Style="{StaticResource ToolButton}" Click="AddFiles_Click"/>
                    <Button Content="添加文件夹" Style="{StaticResource ToolButton}" Click="AddFolder_Click" Margin="10,0,0,0"/>
                    <Button Content="清空列表" Style="{StaticResource ToolButton}" Click="ClearList_Click" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="重命名模式:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="RenameModeSelector" Width="150" SelectionChanged="RenameModeSelector_SelectionChanged">
                        <ComboBoxItem Content="正则替换" IsSelected="True"/>
                        <ComboBoxItem Content="模板替换"/>
                        <ComboBoxItem Content="添加序号"/>
                        <ComboBoxItem Content="大小写转换"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 配置区和预览区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 配置面板 -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}" Padding="10">
                <StackPanel>
                    <!-- 正则替换 -->
                    <StackPanel x:Name="RegexPanel">
                        <TextBlock Text="查找模式 (正则):" Margin="0,0,0,5" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox x:Name="PatternBox" Margin="0,0,0,10"/>
                        <TextBlock Text="替换为:" Margin="0,0,0,5" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox x:Name="ReplacementBox" Margin="0,0,0,10"/>
                        <CheckBox x:Name="CaseSensitiveBox" Content="区分大小写" Margin="0,0,0,5"/>
                        <CheckBox x:Name="IncludeExtensionBox" Content="包含扩展名" Margin="0,0,0,10"/>
                    </StackPanel>

                    <!-- 模板替换 -->
                    <StackPanel x:Name="TemplatePanel" Visibility="Collapsed">
                        <TextBlock Text="模板 (支持 {name}, {ext}, {date}, {time}, {index}):" Margin="0,0,0,5" 
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox x:Name="TemplateBox" Text="{}{name}_{date}" Margin="0,0,0,10"/>
                        <TextBlock Text="起始序号:" Margin="0,0,0,5" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox x:Name="StartIndexBox" Text="1" Margin="0,0,0,10"/>
                    </StackPanel>

                    <!-- 添加序号 -->
                    <StackPanel x:Name="NumberingPanel" Visibility="Collapsed">
                        <TextBlock Text="前缀:" Margin="0,0,0,5" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox x:Name="PrefixBox" Margin="0,0,0,10"/>
                        <TextBlock Text="后缀:" Margin="0,0,0,5" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox x:Name="SuffixBox" Margin="0,0,0,10"/>
                        <TextBlock Text="分隔符:" Margin="0,0,0,5" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox x:Name="SeparatorBox" Text="_" Margin="0,0,0,10"/>
                        <TextBlock Text="起始序号:" Margin="0,0,0,5" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox x:Name="NumberStartBox" Text="1" Margin="0,0,0,10"/>
                    </StackPanel>

                    <!-- 大小写转换 -->
                    <StackPanel x:Name="CasePanel" Visibility="Collapsed">
                        <TextBlock Text="转换模式:" Margin="0,0,0,5" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ComboBox x:Name="CaseModeSelector" Margin="0,0,0,10">
                            <ComboBoxItem Content="全部大写 (upper)"/>
                            <ComboBoxItem Content="全部小写 (lower)"/>
                            <ComboBoxItem Content="首字母大写 (title)"/>
                            <ComboBoxItem Content="驼峰命名 (camel)"/>
                        </ComboBox>
                    </StackPanel>

                    <Button Content="预览" Style="{StaticResource ToolButton}" Click="Preview_Click" Margin="0,10,0,0"/>
                    <Button Content="执行重命名" Style="{StaticResource AccentButton}" Click="Execute_Click" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- 预览列表 -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="预览" FontWeight="SemiBold" Margin="10,8,10,8"
                               Foreground="{StaticResource TextBrush}"/>
                    <ListView x:Name="PreviewList" Grid.Row="1"
                              Background="{StaticResource BgPanelBrush}" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="原文件名" Width="200" DisplayMemberBinding="{Binding Original}"/>
                                <GridViewColumn Header="新文件名" Width="200" DisplayMemberBinding="{Binding New}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Style="{StaticResource CardPanel}" Margin="0,10,0,0" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusText" Style="{StaticResource StatusText}" Text="就绪"/>
                <TextBlock x:Name="CountText" Style="{StaticResource StatusText}" Margin="20,0,0,0"
                           Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="NEManager.App.Views.PePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDeepBrush}"
             FontFamily="{StaticResource UIFont}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════ 工具栏 ══════════ -->
        <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,10" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="PE 二进制解析" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="PathBox" Width="380" VerticalContentAlignment="Center"
                         Style="{StaticResource ModernTextBox}" Margin="0,0,6,0"/>
                <Button x:Name="BrowseBtn" Content="浏览…" Style="{StaticResource ToolButton}" Padding="10,5" Click="Browse_Click"/>
                <Button x:Name="ParseBtn" Content="解析" Style="{StaticResource AccentButton}" Padding="10,5" Click="Parse_Click" Margin="4,0,0,0"/>
                <Separator Width="10" Background="Transparent"/>
                <Button Content="字符串" Style="{StaticResource ToolButton}" Padding="10,5" Click="ExtractStrings_Click" ToolTip="从二进制中提取所有可打印字符串"/>
                <Button Content="提取图标" Style="{StaticResource ToolButton}" Padding="10,5" Click="ExtractIcon_Click" ToolTip="从 PE 文件提取关联图标" Margin="4,0,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="KindText" Grid.Row="1" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="0,0,0,10"/>

        <!-- ══════════ Tab 内容 ══════════ -->
        <Border Grid.Row="2" Style="{StaticResource CardPanel}" Padding="10">
            <TabControl x:Name="Tabs" Background="Transparent" IsEnabled="False">
                <TabItem Header="概览">
                    <DataGrid x:Name="OverviewGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="{StaticResource BgPanelBrush}" Foreground="{StaticResource TextBrush}"
                              RowBackground="{StaticResource BgPanelBrush}" AlternatingRowBackground="{StaticResource BgElevatedBrush}"
                              BorderBrush="{StaticResource BorderBrush}" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="属性" Binding="{Binding Key}" Width="200"/>
                            <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="节表">
                    <DataGrid x:Name="SectionGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="{StaticResource BgPanelBrush}" Foreground="{StaticResource TextBrush}"
                              RowBackground="{StaticResource BgPanelBrush}" AlternatingRowBackground="{StaticResource BgElevatedBrush}"
                              BorderBrush="{StaticResource BorderBrush}" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="100"/>
                            <DataGridTextColumn Header="虚拟大小" Binding="{Binding VirtualSize}" Width="100"/>
                            <DataGridTextColumn Header="虚拟地址" Binding="{Binding VirtualAddress, StringFormat=0x{0:X8}}" Width="110"/>
                            <DataGridTextColumn Header="原始大小" Binding="{Binding RawSize}" Width="100"/>
                            <DataGridTextColumn Header="原始地址" Binding="{Binding RawAddress, StringFormat=0x{0:X8}}" Width="110"/>
                            <DataGridTextColumn Header="熵" Binding="{Binding EntropyText}" Width="70"/>
                            <DataGridTextColumn Header="特征" Binding="{Binding CharacteristicsText}" Width="*"/>
                            <DataGridTextColumn Header="可疑打包" Binding="{Binding PackedText}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="导入表">
                    <TreeView x:Name="ImportTree" Background="{StaticResource BgPanelBrush}"
                              Foreground="{StaticResource TextBrush}"/>
                </TabItem>
                <TabItem Header="导出表">
                    <DataGrid x:Name="ExportGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="{StaticResource BgPanelBrush}" Foreground="{StaticResource TextBrush}"
                              RowBackground="{StaticResource BgPanelBrush}" AlternatingRowBackground="{StaticResource BgElevatedBrush}"
                              BorderBrush="{StaticResource BorderBrush}" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="序号" Binding="{Binding Ordinal}" Width="80"/>
                            <DataGridTextColumn Header="地址" Binding="{Binding Address, StringFormat=0x{0:X8}}" Width="110"/>
                            <DataGridTextColumn Header="转发" Binding="{Binding Forwarder}" Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="资源">
                    <DataGrid x:Name="ResourceGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="{StaticResource BgPanelBrush}" Foreground="{StaticResource TextBrush}"
                              RowBackground="{StaticResource BgPanelBrush}" AlternatingRowBackground="{StaticResource BgElevatedBrush}"
                              BorderBrush="{StaticResource BorderBrush}" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="120"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="语言" Binding="{Binding LanguageName}" Width="140"/>
                            <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="数据目录">
                    <DataGrid x:Name="DirGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="{StaticResource BgPanelBrush}" Foreground="{StaticResource TextBrush}"
                              RowBackground="{StaticResource BgPanelBrush}" AlternatingRowBackground="{StaticResource BgElevatedBrush}"
                              BorderBrush="{StaticResource BorderBrush}" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="RVA" Binding="{Binding RvaText}" Width="120"/>
                            <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="数字签名">
                    <DataGrid x:Name="SigGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="{StaticResource BgPanelBrush}" Foreground="{StaticResource TextBrush}"
                              RowBackground="{StaticResource BgPanelBrush}" AlternatingRowBackground="{StaticResource BgElevatedBrush}"
                              BorderBrush="{StaticResource BorderBrush}" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="字段" Binding="{Binding Item1}" Width="160"/>
                            <DataGridTextColumn Header="值" Binding="{Binding Item2}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>

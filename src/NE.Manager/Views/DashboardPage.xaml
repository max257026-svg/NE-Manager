<UserControl x:Class="NEManager.App.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDeepBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="实时仪表盘" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center"/>
                <Border Background="{StaticResource AccentBrush}" CornerRadius="10" Padding="10,3" Margin="14,4,0,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="StatusLabel" Text="采样中..." FontSize="11.5" Foreground="White"/>
                </Border>
            </StackPanel>

            <!-- 指标卡片 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
                <!-- CPU -->
                <Border Background="{StaticResource BgPanelBrush}" CornerRadius="8" Padding="18,14" Width="220" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="CPU" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="CpuLabel" Text="—" FontSize="36" FontWeight="Bold" Foreground="#58A6FF"
                                   FontFamily="Consolas"/>
                    </StackPanel>
                </Border>
                <!-- MEM -->
                <Border Background="{StaticResource BgPanelBrush}" CornerRadius="8" Padding="18,14" Width="220">
                    <StackPanel>
                        <TextBlock Text="内存" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="MemLabel" Text="—" FontSize="36" FontWeight="Bold" Foreground="#3FB950"
                                   FontFamily="Consolas"/>
                        <TextBlock x:Name="MemDetailLabel" Text="" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- CPU 图 -->
            <Border Grid.Row="2" Background="{StaticResource BgPanelBrush}" CornerRadius="8" Margin="0,0,0,14">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="140"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="CPU 使用率（近 60 帧）" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <Canvas x:Name="CpuChart" Grid.Row="1"/>
                </Grid>
            </Border>

            <!-- MEM 图 -->
            <Border Grid.Row="3" Background="{StaticResource BgPanelBrush}" CornerRadius="8">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="140"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="内存使用率（近 60 帧）" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <Canvas x:Name="MemChart" Grid.Row="1"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

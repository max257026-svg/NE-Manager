<UserControl x:Class="NEManager.App.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDeepBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="系统实时仪表盘" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusLabel" Text="采样中..." FontSize="12" Margin="14,4,0,0"
                       Foreground="{StaticResource TextMutedBrush}"/>
            <Border x:Name="LiveDot" Width="10" Height="10" Background="{StaticResource SuccessBrush}"
                    CornerRadius="5" Margin="10,0,0,0" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Opacity" Value="1"/>
                        <Style.Triggers>
                            <Trigger Property="Visibility" Value="Visible">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0.3" Duration="0:0:0.5"
                                                             AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </StackPanel>

        <!-- CPU 仪表盘 -->
        <Border Grid.Row="1" Background="{StaticResource BgPanelBrush}" CornerRadius="6" Margin="0,0,0,10">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="CPU 使用率" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="CpuLabel" Text="0%" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" Margin="12,-2,0,0"/>
                </StackPanel>
                <Canvas x:Name="CpuChart" Grid.Row="1" Margin="0,12,0,0" ClipToBounds="True"/>
            </Grid>
        </Border>

        <!-- 内存 仪表盘 -->
        <Border Grid.Row="2" Background="{StaticResource BgPanelBrush}" CornerRadius="6">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="内存使用率" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="MemLabel" Text="0%" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource InfoBrush}" Margin="12,-2,0,0"/>
                </StackPanel>
                <Canvas x:Name="MemChart" Grid.Row="1" Margin="0,12,0,0" ClipToBounds="True"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

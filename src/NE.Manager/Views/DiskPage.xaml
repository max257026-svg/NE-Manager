<UserControl x:Class="NEManager.App.Views.DiskPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDeepBrush}"
             FontFamily="{StaticResource UIFont}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════ 工具栏 ══════════ -->
        <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,10" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="磁盘 / 卷 / 虚拟磁盘" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button x:Name="MountVhdBtn" Content="挂载 VHD" Style="{StaticResource ToolButton}" Padding="10,5" Click="MountVhd_Click"/>
                <Button x:Name="UnmountVhdBtn" Content="卸载 VHD" Style="{StaticResource ToolButton}" Padding="10,5" Click="UnmountVhd_Click" Margin="4,0,0,0"/>
                <Button x:Name="MountIsoBtn" Content="挂载 ISO" Style="{StaticResource ToolButton}" Padding="10,5" Click="MountIso_Click" Margin="4,0,0,0"/>
                <Button x:Name="UnmountIsoBtn" Content="卸载 ISO" Style="{StaticResource ToolButton}" Padding="10,5" Click="UnmountIso_Click" Margin="4,0,0,0"/>
                <Separator Width="12" Background="Transparent"/>
                <Button x:Name="ShadowBtn" Content="创建卷影副本" Style="{StaticResource ToolButton}" Padding="10,5" Click="Shadow_Click"/>
                <Button x:Name="BcdBtn" Content="导出 BCD" Style="{StaticResource ToolButton}" Padding="10,5" Click="Bcd_Click" Margin="4,0,0,0"/>
                <Button x:Name="BootTimeoutBtn" Content="启动超时" Style="{StaticResource ToolButton}" Padding="10,5" Click="BootTimeout_Click" Margin="4,0,0,0"/>
                <Separator Width="12" Background="Transparent"/>
                <Button x:Name="RawBtn" Content="原始扇区读取" Style="{StaticResource DangerButton}" Padding="10,5" Click="Raw_Click"/>
            </StackPanel>
        </Border>

        <!-- ══════════ 卷（逻辑驱动器） ══════════ -->
        <Border Grid.Row="1" Style="{StaticResource CardPanel}" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="卷（逻辑驱动器）" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                <DataGrid Grid.Row="1" x:Name="VolumeGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="{StaticResource BgPanelBrush}" Foreground="{StaticResource TextBrush}"
                          RowBackground="{StaticResource BgPanelBrush}" AlternatingRowBackground="{StaticResource BgElevatedBrush}"
                          BorderBrush="{StaticResource BorderBrush}" GridLinesVisibility="Horizontal"
                          MouseDoubleClick="VolumeGrid_DoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="GUID 路径" Binding="{Binding GuidPath}" Width="260"/>
                        <DataGridTextColumn Header="挂载点" Binding="{Binding MountPoints}" Width="120"/>
                        <DataGridTextColumn Header="卷标" Binding="{Binding Label}" Width="120"/>
                        <DataGridTextColumn Header="文件系统" Binding="{Binding FileSystem}" Width="90"/>
                        <DataGridTextColumn Header="序列号" Binding="{Binding SerialNumber}" Width="110"/>
                        <DataGridTextColumn Header="总大小" Binding="{Binding TotalText}" Width="100"/>
                        <DataGridTextColumn Header="可用" Binding="{Binding FreeText}" Width="100"/>
                        <DataGridTextColumn Header="标志" Binding="{Binding FlagsText}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ══════════ 物理磁盘 ══════════ -->
        <Border Grid.Row="3" Style="{StaticResource CardPanel}" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="物理磁盘" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                <DataGrid Grid.Row="1" x:Name="DriveGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="{StaticResource BgPanelBrush}" Foreground="{StaticResource TextBrush}"
                          RowBackground="{StaticResource BgPanelBrush}" AlternatingRowBackground="{StaticResource BgElevatedBrush}"
                          BorderBrush="{StaticResource BorderBrush}" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="设备路径" Binding="{Binding DevicePath}" Width="160"/>
                        <DataGridTextColumn Header="索引" Binding="{Binding Index}" Width="60"/>
                        <DataGridTextColumn Header="型号" Binding="{Binding Model}" Width="*"/>
                        <DataGridTextColumn Header="接口" Binding="{Binding InterfaceType}" Width="90"/>
                        <DataGridTextColumn Header="序列号" Binding="{Binding SerialNumber}" Width="140"/>
                        <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="110"/>
                        <DataGridTextColumn Header="分区数" Binding="{Binding PartitionCount}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

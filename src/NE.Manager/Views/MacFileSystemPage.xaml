<UserControl x:Class="NEManager.App.Views.MacFileSystemPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDeepBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 镜像选择 -->
        <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,10" Padding="10">
            <StackPanel>
                <TextBlock Text="macOS 文件系统镜像" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="ImagePathBox" Width="500" Margin="0,0,10,0" 
                             Style="{StaticResource ModernTextBox}"
                             TextChanged="ImagePathBox_TextChanged"/>
                    <Button Content="浏览镜像文件" Style="{StaticResource ToolButton}" Click="BrowseImage_Click"/>
                    <Button Content="分析文件系统" Style="{StaticResource ToolButton}" Click="AnalyzeFileSystem_Click" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Style="{StaticResource CardPanel}" Margin="0,0,0,10" Padding="10">
            <StackPanel Orientation="Horizontal">
                <Button Content="&#xE72B; 返回" Style="{StaticResource ToolButton}" Click="Back_Click" x:Name="BackButton" IsEnabled="False"/>
                <Button Content="&#xE72C; 刷新" Style="{StaticResource ToolButton}" Click="Refresh_Click" Margin="10,0,0,0"/>
                <Button Content="&#xE896; 提取到..." Style="{StaticResource ToolButton}" Click="Extract_Click" Margin="10,0,0,0"/>
                <TextBox x:Name="SearchBox" Width="200" Margin="20,0,0,0" 
                         Style="{StaticResource ModernTextBox}"
                         TextChanged="SearchBox_TextChanged"/>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" 
                           VerticalAlignment="Center" Margin="5,0,0,0"
                           Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>
        </Border>

        <!-- 文件列表 -->
        <Border Grid.Row="2" Style="{StaticResource CardPanel}" Padding="0">
            <ListView x:Name="FileList" Background="Transparent" BorderThickness="0"
                      SelectionMode="Extended" MouseDoubleClick="FileList_MouseDoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="名称" Width="300">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}"
                                                   FontSize="14" Margin="0,0,6,0"
                                                   Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="大小" Width="100" DisplayMemberBinding="{Binding SizeText}"/>
                        <GridViewColumn Header="修改时间" Width="160" DisplayMemberBinding="{Binding ModifiedTime}"/>
                        <GridViewColumn Header="权限" Width="120" DisplayMemberBinding="{Binding Mode}"/>
                        <GridViewColumn Header="所有者" Width="80" DisplayMemberBinding="{Binding Owner}"/>
                        <GridViewColumn Header="组" Width="80" DisplayMemberBinding="{Binding Group}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- 状态栏 -->
        <Border Grid.Row="3" Style="{StaticResource CardPanel}" Margin="0,10,0,0" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusText" Style="{StaticResource StatusText}" Text="就绪"/>
                <TextBlock x:Name="PathText" Style="{StaticResource StatusText}" Margin="20,0,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock x:Name="CountText" Style="{StaticResource StatusText}" Margin="20,0,0,0"
                           Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

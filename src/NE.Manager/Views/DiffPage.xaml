<UserControl x:Class="NEManager.App.Views.DiffPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDeepBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,10" Padding="10">
            <StackPanel Orientation="Horizontal">
                <Button Content="选择文件 A" Style="{StaticResource ToolButton}" Click="SelectFileA_Click"/>
                <TextBlock x:Name="FileAName" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <Separator Width="20" Background="Transparent"/>
                <Button Content="选择文件 B" Style="{StaticResource ToolButton}" Click="SelectFileB_Click"/>
                <TextBlock x:Name="FileBName" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <Separator Width="20" Background="Transparent"/>
                <Button Content="比较" Style="{StaticResource AccentButton}" Click="Compare_Click"/>
            </StackPanel>
        </Border>

        <!-- 对比显示区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardPanel}" Padding="0">
                <TextBox x:Name="DiffLeft" FontFamily="{StaticResource MonoFont}" FontSize="13"
                         Foreground="{StaticResource TextBrush}" Background="{StaticResource BgPanelBrush}"
                         BorderThickness="0" IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" Padding="10"/>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardPanel}" Padding="0">
                <TextBox x:Name="DiffRight" FontFamily="{StaticResource MonoFont}" FontSize="13"
                         Foreground="{StaticResource TextBrush}" Background="{StaticResource BgPanelBrush}"
                         BorderThickness="0" IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" Padding="10"/>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Style="{StaticResource CardPanel}" Margin="0,10,0,0" Padding="10">
            <TextBlock x:Name="StatusText" Style="{StaticResource StatusText}" Text="未选择文件"/>
        </Border>
    </Grid>
</UserControl>

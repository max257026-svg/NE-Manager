<Window x:Class="NEManager.App.Views.RegistryValueEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="注册表值" Height="520" Width="640" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDeepBrush}"
        FontFamily="{StaticResource UIFont}"
        Foreground="{StaticResource TextBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="KeyPathText" Style="{StaticResource MonoText}"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="值名称：" VerticalAlignment="Center" Style="{StaticResource StatusText}"/>
            <TextBox Grid.Column="1" x:Name="NameBox" VerticalContentAlignment="Center" Height="32"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="数据类型：" VerticalAlignment="Center" Style="{StaticResource StatusText}"/>
            <ComboBox Grid.Column="1" x:Name="TypeBox" Height="32" VerticalContentAlignment="Center"
                      SelectionChanged="TypeBox_SelectionChanged">
                <ComboBoxItem Content="REG_SZ（字符串）" Tag="String"/>
                <ComboBoxItem Content="REG_EXPAND_SZ（可展开字符串）" Tag="ExpandString"/>
                <ComboBoxItem Content="REG_MULTI_SZ（多字符串）" Tag="MultiString"/>
                <ComboBoxItem Content="REG_DWORD（32 位数）" Tag="DWord"/>
                <ComboBoxItem Content="REG_QWORD（64 位数）" Tag="QWord"/>
                <ComboBoxItem Content="REG_BINARY（二进制）" Tag="Binary"/>
            </ComboBox>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CardPanel}" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="DataHint" Style="{StaticResource StatusText}" Margin="0,0,0,6"/>
                <TextBox Grid.Row="1" x:Name="DataBox" AcceptsReturn="True"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                         FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" x:Name="ErrorText" Style="{StaticResource StatusText}"
                   Foreground="{StaticResource DangerBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="确定" Style="{StaticResource AccentButton}" Click="Ok_Click" MinWidth="90"/>
            <Button Content="取消" Style="{StaticResource ToolButton}" Click="Cancel_Click" MinWidth="90"/>
        </StackPanel>
    </Grid>
</Window>
